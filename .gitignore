# ============================================================
# OJ 调试平台 .gitignore
# 【重要】评分标准「代码规范（5分）+ 扣分项」明确写了：
#   "正确使用git，避免将大文件提交到git，这将会是扣分项"
# 所以本文件故意把以下所有本地生成文件、数据库、临时调试脚本、日志全忽略。
# 只保留生产代码 + 必要交付物（源码、启动脚本、静态资源）。
# ============================================================

# ---- Python 缓存 ----
# pyc / __pycache__ 是本地字节码，跨平台不兼容，绝不能入库。
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
webapp/__pycache__/
oj_judge/__pycache__/

# ---- 本地数据库与日志（平台运行时产生，不该入库） ----
# 每台机器 DB 不同，管理员密码 hash、submission 记录都是用户私有，入库会泄密+变大文件
data/
logs/
user.db
*.db
webapp/*.db
*.log
_r_*.txt
_r_server.log
_st_log_*.txt
_fastapi_stdout*.txt
_fastapi_stderr*.txt
_uvicorn_*.log
_chk_profile.*
_check*.log
backup_original/
temp/

# ---- 前序调试 / 冒烟 / 爬虫临时脚本（下划线前缀全部视为临时）----
_*.py
_*.html
_*.out
_probe_*
_dump_*
_tmp_*
_v2b_*
_v3_*
_verify_*
_smoke_*.py

# ---- 所有以前的老冒烟脚本（已经被 smoke_tests_v6.py 替代）----
test_*.py
_smoke_*.py

# ---- 本地 IDE / 沙箱产物 ----
.trae/
.dbg/
.idea/
.vscode/
*.swp

# ---- 打包 / 环境 ----
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ---- 报告导出物 / 截图（保留本地交付，不纳入 Git 历史） ----
项目文档/实验报告/*.pdf
项目文档/实验报告/*.html
项目文档/实验报告/截图/*.png
项目文档/实验报告/截图/*.html
